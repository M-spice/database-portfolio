graph ER {
  graph [layout=neato, overlap=false, splines=true, sep="+12", fontname="Helvetica", label="Itoju Clinics: entities and relationships", labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=11, len=1.6];
  Patient [shape=box, style=filled, fillcolor="#e8eef7"];
  NextOfKin [shape=box, style=filled, fillcolor="#e8eef7", peripheries=2];
  Consent [shape=box, style=filled, fillcolor="#e8eef7"];
  Facility [shape=box, style=filled, fillcolor="#e8eef7"];
  Department [shape=box, style=filled, fillcolor="#e8eef7"];
  Staff [shape=box, style=filled, fillcolor="#e8eef7"];
  Clinician [shape=box, style=filled, fillcolor="#e8eef7"];
  Appointment [shape=box, style=filled, fillcolor="#e8eef7"];
  Encounter [shape=box, style=filled, fillcolor="#e8eef7"];
  VitalSign [shape=box, style=filled, fillcolor="#e8eef7"];
  Diagnosis [shape=box, style=filled, fillcolor="#e8eef7"];
  ClinicalNote [shape=box, style=filled, fillcolor="#e8eef7"];
  Drug [shape=box, style=filled, fillcolor="#e8eef7"];
  Prescription [shape=box, style=filled, fillcolor="#e8eef7"];
  StockMovement [shape=box, style=filled, fillcolor="#e8eef7"];
  LabTest [shape=box, style=filled, fillcolor="#e8eef7"];
  LabOrder [shape=box, style=filled, fillcolor="#e8eef7"];
  LabResult [shape=box, style=filled, fillcolor="#e8eef7"];
  Invoice [shape=box, style=filled, fillcolor="#e8eef7"];
  InvoiceLine [shape=box, style=filled, fillcolor="#e8eef7", peripheries=2];
  Payment [shape=box, style=filled, fillcolor="#e8eef7"];
  r_HAS_KIN [shape=diamond, label="HAS_KIN", style=filled, fillcolor="#fdf1d8", peripheries=2];
  Patient -- r_HAS_KIN [taillabel="1", labeldistance=1.6, labelangle=25];
  NextOfKin -- r_HAS_KIN [taillabel="N", labeldistance=1.6, labelangle=25];
  r_GIVES [shape=diamond, label="GIVES", style=filled, fillcolor="#fdf1d8"];
  Patient -- r_GIVES [taillabel="1", labeldistance=1.6, labelangle=25];
  Consent -- r_GIVES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_IS_A [shape=diamond, label="IS_A", style=filled, fillcolor="#fdf1d8"];
  Staff -- r_IS_A [taillabel="1", labeldistance=1.6, labelangle=25];
  Clinician -- r_IS_A [taillabel="1", labeldistance=1.6, labelangle=25];
  r_BASED_AT [shape=diamond, label="BASED_AT", style=filled, fillcolor="#fdf1d8"];
  Staff -- r_BASED_AT [taillabel="N", labeldistance=1.6, labelangle=25];
  Facility -- r_BASED_AT [taillabel="1", labeldistance=1.6, labelangle=25];
  r_WORKS_IN [shape=diamond, label="WORKS_IN", style=filled, fillcolor="#fdf1d8"];
  Clinician -- r_WORKS_IN [taillabel="M", labeldistance=1.6, labelangle=25];
  Department -- r_WORKS_IN [taillabel="N", labeldistance=1.6, labelangle=25];
  r_BOOKS [shape=diamond, label="BOOKS", style=filled, fillcolor="#fdf1d8"];
  Patient -- r_BOOKS [taillabel="1", labeldistance=1.6, labelangle=25];
  Appointment -- r_BOOKS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_WITH [shape=diamond, label="WITH", style=filled, fillcolor="#fdf1d8"];
  Clinician -- r_WITH [taillabel="1", labeldistance=1.6, labelangle=25];
  Appointment -- r_WITH [taillabel="N", labeldistance=1.6, labelangle=25];
  r_IN [shape=diamond, label="IN", style=filled, fillcolor="#fdf1d8"];
  Department -- r_IN [taillabel="1", labeldistance=1.6, labelangle=25];
  Appointment -- r_IN [taillabel="N", labeldistance=1.6, labelangle=25];
  r_HELD_AT [shape=diamond, label="HELD_AT", style=filled, fillcolor="#fdf1d8"];
  Facility -- r_HELD_AT [taillabel="1", labeldistance=1.6, labelangle=25];
  Appointment -- r_HELD_AT [taillabel="N", labeldistance=1.6, labelangle=25];
  r_RESULTS_IN [shape=diamond, label="RESULTS_IN", style=filled, fillcolor="#fdf1d8"];
  Appointment -- r_RESULTS_IN [taillabel="1", labeldistance=1.6, labelangle=25];
  Encounter -- r_RESULTS_IN [taillabel="1", labeldistance=1.6, labelangle=25];
  r_ATTENDS [shape=diamond, label="ATTENDS", style=filled, fillcolor="#fdf1d8"];
  Patient -- r_ATTENDS [taillabel="1", labeldistance=1.6, labelangle=25];
  Encounter -- r_ATTENDS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_CONDUCTS [shape=diamond, label="CONDUCTS", style=filled, fillcolor="#fdf1d8"];
  Clinician -- r_CONDUCTS [taillabel="1", labeldistance=1.6, labelangle=25];
  Encounter -- r_CONDUCTS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_HOSTS [shape=diamond, label="HOSTS", style=filled, fillcolor="#fdf1d8"];
  Facility -- r_HOSTS [taillabel="1", labeldistance=1.6, labelangle=25];
  Encounter -- r_HOSTS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_MEASURES [shape=diamond, label="MEASURES", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_MEASURES [taillabel="1", labeldistance=1.6, labelangle=25];
  VitalSign -- r_MEASURES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_DIAGNOSED_AS [shape=diamond, label="DIAGNOSED_AS", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_DIAGNOSED_AS [taillabel="M", labeldistance=1.6, labelangle=25];
  Diagnosis -- r_DIAGNOSED_AS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_DOCUMENTS [shape=diamond, label="DOCUMENTS", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_DOCUMENTS [taillabel="1", labeldistance=1.6, labelangle=25];
  ClinicalNote -- r_DOCUMENTS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_AMENDS [shape=diamond, label="AMENDS", style=filled, fillcolor="#fdf1d8"];
  ClinicalNote -- r_AMENDS [taillabel="1", labeldistance=1.6, labelangle=25];
  ClinicalNote -- r_AMENDS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_ISSUES [shape=diamond, label="ISSUES", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_ISSUES [taillabel="1", labeldistance=1.6, labelangle=25];
  Prescription -- r_ISSUES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_PRESCRIBES [shape=diamond, label="PRESCRIBES", style=filled, fillcolor="#fdf1d8"];
  Prescription -- r_PRESCRIBES [taillabel="M", labeldistance=1.6, labelangle=25];
  Drug -- r_PRESCRIBES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_STOCKS [shape=diamond, label="STOCKS", style=filled, fillcolor="#fdf1d8"];
  Facility -- r_STOCKS [taillabel="M", labeldistance=1.6, labelangle=25];
  Drug -- r_STOCKS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_MOVES [shape=diamond, label="MOVES", style=filled, fillcolor="#fdf1d8"];
  Drug -- r_MOVES [taillabel="1", labeldistance=1.6, labelangle=25];
  StockMovement -- r_MOVES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_AT [shape=diamond, label="AT", style=filled, fillcolor="#fdf1d8"];
  Facility -- r_AT [taillabel="1", labeldistance=1.6, labelangle=25];
  StockMovement -- r_AT [taillabel="N", labeldistance=1.6, labelangle=25];
  r_FULFILS [shape=diamond, label="FULFILS", style=filled, fillcolor="#fdf1d8"];
  Prescription -- r_FULFILS [taillabel="1", labeldistance=1.6, labelangle=25];
  StockMovement -- r_FULFILS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_ORDERS [shape=diamond, label="ORDERS", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_ORDERS [taillabel="1", labeldistance=1.6, labelangle=25];
  LabOrder -- r_ORDERS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_OF_TEST [shape=diamond, label="OF_TEST", style=filled, fillcolor="#fdf1d8"];
  LabTest -- r_OF_TEST [taillabel="1", labeldistance=1.6, labelangle=25];
  LabOrder -- r_OF_TEST [taillabel="N", labeldistance=1.6, labelangle=25];
  r_PRODUCES [shape=diamond, label="PRODUCES", style=filled, fillcolor="#fdf1d8"];
  LabOrder -- r_PRODUCES [taillabel="1", labeldistance=1.6, labelangle=25];
  LabResult -- r_PRODUCES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_SUPERSEDES [shape=diamond, label="SUPERSEDES", style=filled, fillcolor="#fdf1d8"];
  LabResult -- r_SUPERSEDES [taillabel="1", labeldistance=1.6, labelangle=25];
  LabResult -- r_SUPERSEDES [taillabel="1", labeldistance=1.6, labelangle=25];
  r_BILLED_TO [shape=diamond, label="BILLED_TO", style=filled, fillcolor="#fdf1d8"];
  Patient -- r_BILLED_TO [taillabel="1", labeldistance=1.6, labelangle=25];
  Invoice -- r_BILLED_TO [taillabel="N", labeldistance=1.6, labelangle=25];
  r_BILLS [shape=diamond, label="BILLS", style=filled, fillcolor="#fdf1d8"];
  Encounter -- r_BILLS [taillabel="1", labeldistance=1.6, labelangle=25];
  Invoice -- r_BILLS [taillabel="1", labeldistance=1.6, labelangle=25];
  r_CONTAINS [shape=diamond, label="CONTAINS", style=filled, fillcolor="#fdf1d8", peripheries=2];
  Invoice -- r_CONTAINS [taillabel="1", labeldistance=1.6, labelangle=25];
  InvoiceLine -- r_CONTAINS [taillabel="N", labeldistance=1.6, labelangle=25];
  r_SETTLED_BY [shape=diamond, label="SETTLED_BY", style=filled, fillcolor="#fdf1d8"];
  Invoice -- r_SETTLED_BY [taillabel="1", labeldistance=1.6, labelangle=25];
  Payment -- r_SETTLED_BY [taillabel="N", labeldistance=1.6, labelangle=25];
  r_ACCESSES [shape=diamond, label="ACCESSES", style=filled, fillcolor="#fdf1d8"];
  Staff -- r_ACCESSES [taillabel="M", labeldistance=1.6, labelangle=25];
  Patient -- r_ACCESSES [taillabel="N", labeldistance=1.6, labelangle=25];
  r_ON_CALL [shape=diamond, label="ON_CALL", style=filled, fillcolor="#fdf1d8"];
  Clinician -- r_ON_CALL [taillabel="M", labeldistance=1.6, labelangle=25];
  Facility -- r_ON_CALL [taillabel="N", labeldistance=1.6, labelangle=25];
}
